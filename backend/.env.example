# Copy to .env (or set in your deployment). See src/config.ts for every option.
NODE_ENV=development
DATABASE_URL=postgres://redcore:redcore@localhost:5432/redcore
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# MFA is mandatory for admins (spec §6). Set false only for local experiments.
REQUIRE_MFA=true
# ECDSA P-256 private key used to sign device commands. `npm run keys:generate`.
# COMMAND_SIGNING_KEY_FILE=./command-signing-key.pem
# Google service account (FCM push + Play Integrity):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FCM_PROJECT_ID=your-firebase-project
# INTEGRITY_ENFORCE=false
# Device Owner QR provisioning:
# AGENT_APK_URL=https://downloads.example.com/redcore-agent.apk
# AGENT_APK_SIGNATURE_CHECKSUM=<url-safe base64 SHA-256 of the APK signing certificate>
